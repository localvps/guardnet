# =====================================================================
#  GuardNet TURN/STUN - the ONLY WebRTC server for this deployment.
#  Self-hosted on xxxxxx (YOUR_PUBLIC_IP). No third-party dependency:
#  no Google STUN, no Cloudflare STUN, no public TURN.
# =====================================================================

# ---- listeners -----------------------------------------------------
listening-port=3478
tls-listening-port=5349

# ---- relay capacity ------------------------------------------------
# Every call is relayed (iceTransportPolicy=relay), so each peer holds
# one allocation: a call costs 2 relay ports. Keep the range wide.
min-port=49160
max-port=65535
relay-threads=4

# ---- authentication ------------------------------------------------
# Time-based shared secret: clients get short-lived HMAC credentials
# from /api/calls/ice, the long-term secret never leaves this box.
fingerprint
lt-cred-mech
use-auth-secret
static-auth-secret=REPLACE_WITH_OUTPUT_OF_openssl_rand_hex_32
realm=xxxxxx
stale-nonce=600

# ---- addressing ----------------------------------------------------
external-ip=YOUR_PUBLIC_IP

# ---- hardening -----------------------------------------------------
# Never relay into private/loopback ranges: stops TURN abuse as an
# open relay / internal network scanner.
no-multicast-peers
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.0.2.0-192.0.2.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=198.51.100.0-198.51.100.255
denied-peer-ip=203.0.113.0-203.0.113.255
denied-peer-ip=224.0.0.0-255.255.255.255
denied-peer-ip=240.0.0.0-255.255.255.255
no-cli
no-software-attribute

# ---- TLS / DTLS on 5349 (turns:) ----------------------------------
cert=/etc/coturn-certs/turn.crt
pkey=/etc/coturn-certs/turn.key
no-sslv3
no-tlsv1
no-tlsv1_1

# ---- limits --------------------------------------------------------
# No artificial bandwidth ceiling: never throttle call quality.
bps-capacity=0
total-quota=6000
log-file=stdout
simple-log
